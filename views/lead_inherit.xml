<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="crm_lead_new_client">
        <field name="name">crm.lead.new.client</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//div[2]//h1" position="after">
                <group>
                    <field name="reference" readonly="1" invisible="type != 'opportunity'"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='expected_revenue']" position="attributes">
                <attribute name="string">PNB espéré</attribute>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="convert_dossier" string="Lancer le dossier" type="object" class="oe_highlight"
                        invisible="type != 'opportunity'"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="string">Chargé d'Affaire</attribute>
                <attribute name="domain">domain_user_id</attribute>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="before">
                <field name="team_lead" domain="domain_team_lead" widget="many2one_avatar_user"/>
                <field name="domain_team_lead" invisible="1"/>
                <field name="domain_user_id" invisible="1"/>
                <field name="state_conversion" invisible="1"/>
            </xpath>
            <xpath expr="//group[@name='lead_partner']//field[@name='partner_id']" position="after">
                <field name="geographic_area"/>
            </xpath>
            <xpath expr="//group[@name='opportunity_partner']//field[@name='partner_id']" position="after">
                <field name="geographic_area"/>
            </xpath>
            <xpath expr="//sheet//div[2]" position="after">
                <group>
                    <group>
                        <field name="total_engagement" widget='monetary' options="{'currency_field': 'company_currency'}"/>
                        <field name="turnover" widget='monetary' options="{'currency_field': 'company_currency'}"/>
                        <field name="comex" widget='radio'/>
                        <field name="category"/>
                    </group>
                </group>
            </xpath>
            <button name="%(crm.action_crm_lead2opportunity_partner)d" position="attributes">
                <attribute name="invisible">type == 'opportunity' or not active or state_conversion != 'in_lead'</attribute>
            </button>
            <button name="%(crm.action_crm_lead2opportunity_partner)d" position="after">
                <button name="accept_lead_conversion" string="Accepter" type="object" help="Accepter la conversion"
                        class="oe_highlight" invisible="type == 'opportunity' or not active or state_conversion != 'in_conversion'" data-hotkey="v"/>
                <button name="decline_lead_conversion" string="Réfuser" type="object" help="Réfuser la conversion"
                        invisible="type == 'opportunity' or not active or state_conversion != 'in_conversion'" data-hotkey="v"/>
            </button>
            <xpath expr="//page[@name='extra']" position="attributes">
                <attribute name="string">Infos Globales</attribute>
            </xpath>
            <xpath expr="//button[@name='%(crm.crm_lead_lost_action)d']" position="attributes">
                <attribute name="string">Rejeter</attribute>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="open_crv" type="object" class="oe_stat_button" string="Renseigner le CRV"/>
            </xpath>
            <xpath expr="//page[@name='lead']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='extra']" position="inside">
                <group>
                    <group>
                        <field name="date_creation"/>
                        <field name="nrc"/>
                        <field name="nif"/>
                        <field name="nis"/>
                        <field name="rib"/>
                    </group>
                    <group>
                        <field name="branch"/>
                        <field name="num_compte"/>
                        <field name="secteur"/>
                        <field name="activity"/>
                        <field name="demande_type"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//page[@name='extra']" position="after">
                <page name="documents" string="Documents">
                    <field name="document_ids">
                        <tree create="0" delete="0" editable="bottom">
                            <field name="name"/>
                            <field name="datas" widget="file"/>
                        </tree>
                    </field>
                </page>
                <page name="confreres" string="Engagaments auprès des confrères">
                    <field name="confrere_ids">
                        <tree  editable="bottom">
                            <field name="banque"/>
                            <field name="credit"/>
                            <field name="montant"/>
                            <field name="condition"/>
                            <field name="date_echeance"/>
                            <field name="garantie"/>
                        </tree>
                    </field>
                </page>
                <page name="importation" string="Planning d'importation">
                    <field name="importation_ids">
                        <tree  editable="bottom">
                            <field name="fournisseur"/>
                            <field name="pays"/>
                            <field name="payment"/>
                            <field name="delai"/>
                            <field name="montant"/>
                            <field name="programme_importation"/>
                            <field name="delai_livraison"/>
                        </tree>
                    </field>
                </page>
                <page name="appro" string="Plan d`Appro. Local">
                    <field name="appro_ids">
                        <tree  editable="bottom">
                            <field name="marchandise"/>
                            <field name="fournisseur"/>
                            <field name="payment"/>
                            <field name="delai"/>
                            <field name="montant"/>
                            <field name="programme_importation"/>
                        </tree>
                    </field>
                </page>
                <page name="plan" string="Plan des charges">
                    <field name="plan_ids">
                        <tree  editable="bottom">
                            <field name="type_marche"/>
                            <field name="client"/>
                            <field name="dom_bancaire"/>
                            <field name="natissement"/>
                            <field name="montant"/>
                            <field name="objet"/>
                            <field name="date_obs"/>
                            <field name="delai"/>
                            <field name="taux"/>
                            <field name="montant_facture"/>
                            <field name="montant_encaisse"/>
                            <field name="montant_fact_no_encaisse"/>
                            <field name="montant_no_fact_realise"/>
                        </tree>
                    </field>
                </page>
                <page name="financial_data" string="Données Financières">
                    <group string="Données Financières">
                        <group>
                            <field name="ca" widget="monetary"/>
                            <field name="capital"/>
                            <field name="rnc"/>
                        </group>
                        <group>
                            <field name="ebe"/>
                            <field name="fp"/>
                            <field name="tb"/>
                        </group>
                    </group>
                    <dic class="row mb-3 d-flex justify-content-between" string="Fichiers TCR">
                        <div class="col-4">
                            <button name="action_create_tcr" type="object" string="Ajouter TCR pour l annee N et N-1"
                                    invisible="tcr_id != False"/>
                            <label for="tcr_id" class="col-lg-4 o_light_label" invisible="tcr_id == False"/>
                            <field name="tcr_id" invisible="tcr_id == False" readonly="1"/>
                        </div>
                        <div class="col-4">
                            <button name="action_create_actif" type="object"
                                    string="Ajouter Actif pour l annee N et N-1"
                                    invisible="actif_id != False"/>
                            <label for="actif_id" class="col-lg-4 o_light_label" invisible="actif_id == False"/>
                            <field name="actif_id" invisible="actif_id == False" readonly="1"/>
                        </div>
                        <div class="col-4">
                            <button name="action_create_passif" type="object"
                                    string="Ajouter Passif pour l annee N et N-1"
                                    invisible="passif_id != False"/>
                            <label for="passif_id" class="col-lg-4 o_light_label" invisible="passif_id == False"/>
                            <field name="passif_id" invisible="passif_id == False" readonly="1"/>
                        </div>
                    </dic>
                    <div class="row mb-3">
                        <div class="col-4">
                            <button name="action_create_tcr1" type="object" string="Ajouter TCR pour l annee 2-N et N-3"
                                    invisible="tcr1_id != False"/>
                            <label for="tcr1_id" class="col-lg-4 o_light_label" invisible="tcr1_id == False"/>
                            <field name="tcr1_id" invisible="tcr1_id == False" readonly="1"/>
                        </div>
                        <div class="col-4">
                            <button name="action_create_actif1" type="object"
                                    string="Ajouter Actif Pour l'annee 2-N et N-3"
                                    invisible="actif1_id != False"/>
                            <label for="actif1_id" class="col-lg-4 o_light_label" invisible="actif1_id == False"/>
                            <field name="actif1_id" invisible="actif1_id == False" readonly="1"/>
                        </div>
                        <div class="col-4">
                            <button name="action_create_passif1" type="object"
                                    string="Ajouter Passif pour l annee 2-N et N-3"
                                    invisible="passif1_id != False"/>
                            <label for="passif1_id" class="col-lg-4 o_light_label" invisible="passif1_id == False"/>
                            <field name="passif1_id" invisible="passif1_id == False" readonly="1"/>
                        </div>
                    </div>
                    <div class="oe_right">
                        <button name="import_data" type="object" class="btn-primary" string="Charger les donnees"/>
                    </div>
                    <group string="Indicateurs de la Structure Financière">
                        <field name="bilan1_id">
                            <tree editable="bottom" create="0" delete="0">
                                <field name="sequence" column_invisible="True"/>
                                <field name="declaration" readonly="1"
                                       decoration-bf="sequence == 0"/>
                                <field name="year_1" readonly="sequence != 0"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_1 == True"/>
                                <field name="year_1_d" readonly="sequence != 0" optional="hide"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_1 == True"/>
                                <field name="year_2" readonly="sequence != 0"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_2 == True"/>
                                <field name="year_2_d" readonly="sequence != 0" optional="hide"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_1 == True"/>
                                <field name="year_3" readonly="sequence != 0"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_3 == True"/>
                                <field name="year_3_d" readonly="sequence != 0" optional="hide"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_1 == True"/>
                                <field name="year_4" readonly="sequence != 0"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_4 == True"/>
                                <field name="year_4_d" readonly="sequence != 0" optional="hide"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_1 == True"/>
                                <field name="variante" readonly="sequence == 0" widget="percentage"
                                       decoration-bf="sequence == 0" invisible="sequence == 0"/>

                                <field name="compute_field" column_invisible="True"/>
                                <field name="is_null_1" column_invisible="True"/>
                                <field name="is_null_2" column_invisible="True"/>
                                <field name="is_null_3" column_invisible="True"/>
                                <field name="is_null_4" column_invisible="True"/>
                            </tree>
                        </field>
                        <group>
                            <field name="comment_cat1"/>
                        </group>

                    </group>
                    <group string="Indicateurs d`endettement">
                        <field name="bilan2_id">
                            <tree editable="bottom" create="0" delete="0">
                                <field name="sequence" column_invisible="True"/>
                                <field name="declaration" readonly="1"
                                       decoration-bf="sequence == 0"/>
                                <field name="year_1" readonly="sequence != 0"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_1 == True"/>
                                <field name="year_1_d" readonly="sequence != 0" optional="hide"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_1 == True"/>
                                <field name="year_2" readonly="sequence != 0"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_2 == True"/>
                                <field name="year_2_d" readonly="sequence != 0" optional="hide"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_1 == True"/>
                                <field name="year_3" readonly="sequence != 0"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_3 == True"/>
                                <field name="year_3_d" readonly="sequence != 0" optional="hide"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_1 == True"/>
                                <field name="year_4" readonly="sequence != 0"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_4 == True"/>
                                <field name="year_4_d" readonly="sequence != 0" optional="hide"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_1 == True"/>
                                <field name="variante" readonly="sequence == 0" widget="percentage"
                                       decoration-bf="sequence == 0" invisible="sequence == 0"/>

                                <field name="compute_field" column_invisible="True"/>
                                <field name="is_null_1" column_invisible="True"/>
                                <field name="is_null_2" column_invisible="True"/>
                                <field name="is_null_3" column_invisible="True"/>
                                <field name="is_null_4" column_invisible="True"/>
                            </tree>
                        </field>
                        <group>
                            <field name="comment_cat2"/>
                        </group>

                    </group>
                    <group string=" Indicateurs de Rentabilité">
                        <field name="bilan3_id">
                            <tree editable="bottom" create="0" delete="0">
                                <field name="sequence" column_invisible="True"/>
                                <field name="declaration" readonly="1"
                                       decoration-bf="sequence == 0"/>
                                <field name="year_1" readonly="sequence != 0"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_1 == True"/>
                                <field name="year_1_d" readonly="sequence != 0" optional="hide"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_1 == True"/>
                                <field name="year_2" readonly="sequence != 0"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_2 == True"/>
                                <field name="year_2_d" readonly="sequence != 0" optional="hide"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_1 == True"/>
                                <field name="year_3" readonly="sequence != 0"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_3 == True"/>
                                <field name="year_3_d" readonly="sequence != 0" optional="hide"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_1 == True"/>
                                <field name="year_4" readonly="sequence != 0"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_4 == True"/>
                                <field name="year_4_d" readonly="sequence != 0" optional="hide"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_1 == True"/>

                                <field name="compute_field" column_invisible="True"/>
                                <field name="is_null_1" column_invisible="True"/>
                                <field name="is_null_2" column_invisible="True"/>
                                <field name="is_null_3" column_invisible="True"/>
                                <field name="is_null_4" column_invisible="True"/>
                            </tree>
                        </field>
                        <group>
                            <field name="comment_cat3"/>
                        </group>

                    </group>
                    <group string="Indicateurs de Liquidité">
                        <field name="bilan4_id">
                            <tree editable="bottom" create="0" delete="0">
                                <field name="sequence" column_invisible="True"/>
                                <field name="declaration" readonly="1"
                                       decoration-bf="sequence == 0"/>
                                <field name="year_1" readonly="sequence != 0"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_1 == True"/>
                                <field name="year_1_d" readonly="sequence != 0" optional="hide"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_1 == True"/>
                                <field name="year_2" readonly="sequence != 0"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_2 == True"/>
                                <field name="year_2_d" readonly="sequence != 0" optional="hide"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_1 == True"/>
                                <field name="year_3" readonly="sequence != 0"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_3 == True"/>
                                <field name="year_3_d" readonly="sequence != 0" optional="hide"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_1 == True"/>
                                <field name="year_4" readonly="sequence != 0"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_4 == True"/>
                                <field name="year_4_d" readonly="sequence != 0" optional="hide"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_1 == True"/>
                                <field name="variante" readonly="sequence == 0" widget="percentage"
                                       decoration-bf="sequence == 0" invisible="sequence == 0"/>

                                <field name="compute_field" column_invisible="True"/>
                                <field name="is_null_1" column_invisible="True"/>
                                <field name="is_null_2" column_invisible="True"/>
                                <field name="is_null_3" column_invisible="True"/>
                                <field name="is_null_4" column_invisible="True"/>
                            </tree>
                        </field>
                        <group>
                            <field name="comment_cat4"/>
                        </group>
                    </group>
                    <group string=" Ratios d`activité ">
                        <field name="bilan5_id">
                            <tree editable="bottom" create="0" delete="0">
                                <field name="sequence" column_invisible="True"/>
                                <field name="declaration" readonly="1"
                                       decoration-bf="sequence == 0"/>
                                <field name="year_1" readonly="sequence != 0"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_1 == True"/>
                                <field name="year_1_d" readonly="sequence != 0" optional="hide"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_1 == True"/>
                                <field name="year_2" readonly="sequence != 0"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_2 == True"/>
                                <field name="year_2_d" readonly="sequence != 0" optional="hide"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_1 == True"/>
                                <field name="year_3" readonly="sequence != 0"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_3 == True"/>
                                <field name="year_3_d" readonly="sequence != 0" optional="hide"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_1 == True"/>
                                <field name="year_4" readonly="sequence != 0"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_4 == True"/>
                                <field name="year_4_d" readonly="sequence != 0" optional="hide"
                                       decoration-bf="sequence == 0" decoration-danger="is_null_1 == True"/>
                                <field name="variante" readonly="sequence == 0" widget="percentage"
                                       decoration-bf="sequence == 0" invisible="sequence == 0"/>

                                <field name="is_null_1" column_invisible="True"/>
                                <field name="is_null_2" column_invisible="True"/>
                                <field name="is_null_3" column_invisible="True"/>
                                <field name="is_null_4" column_invisible="True"/>
                                <field name="compute_field" column_invisible="True"/>
                            </tree>
                        </field>
                        <group>
                            <field name="comment_cat5"/>
                        </group>
                    </group>
                </page>
                <page name="financement_0" invisible="demande_type == '1'" string="Financement sollicité">
                    <field name="financement_ids">
                        <tree  editable="bottom">
                            <field name="type_fin"/>
                            <field name="montant"/>
                            <field name="utilisation"/>
                        </tree>
                    </field>
                    <group>
                        <field name="garanties"/>
                    </group>
                </page>
                <page name="financement_1" invisible="demande_type == '0'" string="Financement sollicité">
                    <field name="financement_ids">
                        <tree  editable="bottom">
                            <field name="type_fin"/>
                            <field name="autorisation_actuel"/>
                            <field name="validite"/>
                            <field name="new_plafond"/>
                        </tree>
                    </field>
                    <group>
                        <field name="garanties"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="crm_portal_crm_case_kanban_view_leads">
        <field name="name">crm_portal.crm.case.kanban.view.leads</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-name='kanban-box']//div[2]//div[1]" position="after">
                <div>
                    <field name="type" invisible="1"/>
                    <strong invisible="type != 'opportunity'"><field name="reference"/></strong>
                </div>
            </xpath>
        </field>
    </record>

    <record id="compte_rendu_views_wizard_form" model="ir.ui.view">
        <field name="name">crm.compte.rendu.wizard.form</field>
        <field name="model">crm.compte.rendu</field>
        <field name="arch" type="xml">
            <form string="Compte rendu de visite">
                <sheet>
                    <group>
                        <field name="visit_date"/>
                        <field name="address"/>
                        <field name="participant_ids" widget="many2many_tags"/>
                        <field name="resume"/>
                        <field name="attachment_ids"
                               domain="[('mimetype', 'in', ['image/jpeg', 'image/png', 'image/jpg', 'image/svg'])]"
                               context="{'default_is_crv': True, 'kanban_view_ref': 'crm_portal.crm_portal_view_document_file_kanban'}" mode="kanban">
                            <form>
                                <sheet>
                                    <group>
                                        <field name="name" readonly="1"/>
                                        <field name="datas"
                                               options="{'accepted_file_extensions': 'image/*'}"
                                               string="Image"
                                               filename="name"/>
                                        <field name="is_printed"/>
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="crm_portal_crm_lead_quick_create">
        <field name="name">crm_portal.crm.lead.quick.create</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.quick_create_opportunity_form"/>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="name" position="before">
                <field name="type_name"/>
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="crm_portal_view_crm_lead2opportunity_partner">
        <field name="name">crm_portal.view.crm.lead2opportunity.partner</field>
        <field name="model">crm.lead2opportunity.partner</field>
        <field name="inherit_id" ref="crm.view_crm_lead2opportunity_partner"/>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="user_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="team_id" position="after">
                <field name="team_lead" readonly="1" force_save="1"/>
            </field>
        </field>
    </record>

    <record model="ir.actions.act_window" id="crm.crm_lead_all_leads">
        <field name="domain">['|', ('type','=','lead'), ('type','=',False), ('state_conversion', '=', 'in_lead')]</field>
    </record>

    <record model="ir.actions.act_window" id="crm_lead_all_leads_in_conversion">
        <field name="name">Pistes en conversion</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">tree,kanban,graph,pivot,calendar,form,activity</field>
        <field name="domain">['|', ('type','=','lead'), ('type','=',False)]</field>
        <field name="search_view_id" ref="crm.view_crm_case_leads_filter"/>
        <field name="context">{
            'create': false,
            'search_default_to_process':1,
            }
        </field>
    </record>
</odoo>